<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Never the internet permission. Niko Dialer works fully offline. -->
    <!-- Call screening is a role granted in a system dialog, not a permission. -->
    <!-- Never CAMERA: photos come from the camera app and the photo picker, which need no permission.
         Declaring it would make the camera app need it too. -->

    <!-- Tap a face, the call starts. Asked the first time a face is tapped. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Save typed people in the phone's contacts, and set and check each person's ringtone.
         One "contacts" question on Android, asked when saving a typed person or recording a name.
         Picking a contact needs neither: the contacts app grants a one-time read. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Record "Mum is calling" for a person's ringtone. Asked at the first recording. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Put the recorded name in the shared Ringtones folder on Android 8 and 9 only, so the
         ringer can play it. From Android 10, MediaStore takes it without a permission.
         Approved by the founder. Asked at the first recording, on Android 8 and 9 only. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Recording needs a microphone, but the dialer still installs on phones without one. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Calling implies a phone; still install on tablets, where the hint line explains. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Android 11+ hides text-to-speech engines from apps that don't ask for them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NikoDialer">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the camera app write one new photo for a face. Not exported, and no camera permission:
             the camera app takes the photo, Dialer only gets the file. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>

        <!-- Silences calls from numbers not saved in the phone, while "Only ring for saved contacts"
             is on. Only the system can bind it, and only while Dialer holds the call screening role. -->
        <service
            android:name=".screening.SilenceService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
    </application>
</manifest>
