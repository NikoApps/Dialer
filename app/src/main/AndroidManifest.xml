<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Never the internet permission. Niko Dialer works fully offline. -->
    <!-- Contacts and microphone come with the features that need them (Hub spec). -->
    <!-- Call screening is a role granted in a system dialog, not a permission. -->
    <!-- Never CAMERA: photos come from the camera app and the photo picker, which need no permission.
         Declaring it would make the camera app need it too. -->

    <!-- Tap a face, the call starts. Asked the first time a face is tapped. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Calling implies a phone; still install on tablets, where the hint line explains. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Android 11+ hides text-to-speech engines from apps that don't ask for them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NikoDialer">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the camera app write one new photo for a face. Not exported, and no camera permission:
             the camera app takes the photo, Dialer only gets the file. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>

        <!-- Silences calls from numbers not saved in the phone, while "Only ring for saved contacts"
             is on. Only the system can bind it, and only while Dialer holds the call screening role. -->
        <service
            android:name=".screening.SilenceService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
    </application>
</manifest>
